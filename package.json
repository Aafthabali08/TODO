{
  "name": "dayform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node check.cjs && node scripts/reminder-sim.mjs",
    "test:reminders": "node scripts/reminder-sim.mjs",
    "reminders:local": "node --env-file=.env.local scripts/run-reminders-local.mjs",
    "admin:set": "node --env-file=.env.local scripts/set-admin.mjs",
    "test:rules": "node --env-file=.env.local scripts/rules-test.mjs",
    "check:prod": "node scripts/prod-check.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.10.0",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "engines": {
    "node": "22.x"
  }
}
